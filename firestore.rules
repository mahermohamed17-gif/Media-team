rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function admin(){return request.auth!=null&&request.auth.token.email in ['your-email@gmail.com'];}
 function ok(){return request.auth!=null&&exists(/databases/$(d)/documents/allowed/$(request.auth.token.email));}
 match /allowed/{e}{allow read:if request.auth!=null&&(admin()||request.auth.token.email==e);allow write:if admin();}
 match /users/{u}{allow read:if admin()||request.auth.uid==u;
  allow create:if request.auth.uid==u&&ok()&&request.resource.data.unlocked==1;
  allow update:if admin();}
 match /subs/{s}{allow read:if admin()||(request.auth!=null&&resource.data.uid==request.auth.uid);
  allow create:if ok()&&request.resource.data.uid==request.auth.uid&&s.matches(request.auth.uid+'_.*')&&request.resource.data.startedAt==request.time;
  allow update:if ok()&&resource.data.uid==request.auth.uid&&request.resource.data.startedAt==resource.data.startedAt&&request.resource.data.uid==request.auth.uid;
  allow delete:if admin();}
 match /grades/{g}{allow read:if admin()||(request.auth!=null&&resource.data.uid==request.auth.uid);allow write:if admin();}
}}
